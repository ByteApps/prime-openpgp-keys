import { Theme, UISize, ButtonVariant, Images, ControlSize } from "@ui/theme.slint";
import { Callbacks, KeyList, Detail, Browser, Ui, KeyRow, DetailRow, FileRow } from "callbacks.slint";
import { Button } from "@ui/button.slint";
import { Icon } from "@ui/icon.slint";
import { Input } from "@ui/input.slint";
import { SegmentedControl } from "@ui/segmented_control.slint";
import { Dialog, DialogVariant } from "@ui/dialog.slint";
import { Checkbox } from "@ui/checkbox.slint";

export { Callbacks, KeyList, Detail, Browser, Ui, KeyRow, DetailRow, FileRow, Theme, Images, ControlSize }

// A round icon button built from a raw TouchArea. The SDK IconButton sizes its
// touch area to a fixed control-size rather than the laid-out size, so its
// clicks don't register once a layout gives it a different size.
component IconBtn inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Theme.palette-foreground;
    in property <length> diameter: 44px;
    callback clicked();

    width: diameter;
    height: diameter;
    border-radius: diameter / 2;
    background: touch.pressed
        ? Theme.palette-secondary-pressed
        : (touch.has-hover ? Theme.palette-secondary : Theme.palette-secondary.with-alpha(0.4));

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.diameter * 0.5;
        icon: root.icon;
        icon-color: root.icon-color;
    }
}

// Passphrase input with a show/hide eye toggle. The SDK Input draws the eye
// through its suffix-icon slot (which reserves text space but takes no taps);
// a TouchArea over the right-edge strip takes the tap. The wrapper forwards
// the Input's layout constraints and lets it fill — a fixed-height wrapper
// shifted every modal's controls off the UI suite's calibrated tap points.
// The tap strip assumes the suffix slot is the RIGHTMOST thing in the field,
// which holds only while PassInput never sets `clearable` (the SDK puts the
// clear X to the suffix icon's right).
component PassInput inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    property <bool> reveal: false;

    preferred-height: field.preferred-height;
    min-height: field.min-height;
    max-height: field.max-height;

    field := Input {
        width: parent.width;
        height: parent.height;
        label: root.label;
        placeholder: root.placeholder;
        input-type: root.reveal ? InputType.text : InputType.password;
        suffix-icon: root.reveal
            ? @image-url("icons/eye-off.svg")
            : @image-url("icons/eye.svg");
        value <=> root.value;
        submitted => {
            field.clear-focus();
        }
    }
    TouchArea {
        width: 56px;
        height: parent.height;
        x: parent.width - self.width;
        clicked => {
            root.reveal = !root.reveal;
        }
    }
}

// One key in the keychain list.
component KeyEntry inherits Rectangle {
    in property <KeyRow> entry;
    height: 64px;
    background: touch.has-hover ? Theme.palette-secondary : transparent;

    Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        source: root.entry.has-secret ? @image-url("icons/key.svg") : @image-url("icons/lock.svg");
        colorize: root.entry.has-secret ? Theme.palette-primary : Theme.palette-foreground;
    }

    chevron := Image {
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        source: @image-url("icons/chevron-right.svg");
        colorize: Theme.palette-muted;
    }

    touch := TouchArea {
        x: 48px;
        y: 0px;
        width: chevron.x - 48px - 8px;
        height: parent.height;
        clicked => {
            Callbacks.open-key(root.entry.filename);
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.entry.title;
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 17px;
                overflow: elide;
            }
            Text {
                text: root.entry.subtitle;
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                overflow: elide;
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.palette-border;
    }
}

// One row in the import file browser.
component FileEntry inherits Rectangle {
    in property <FileRow> entry;
    height: 60px;
    background: touch.has-hover ? Theme.palette-secondary : transparent;

    Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        source: root.entry.is-folder ? @image-url("icons/folder.svg") : @image-url("icons/file.svg");
        colorize: root.entry.is-folder ? Theme.palette-primary : Theme.palette-foreground;
    }

    touch := TouchArea {
        x: 48px;
        y: 0px;
        width: parent.width - 48px;
        height: parent.height;
        clicked => {
            Callbacks.import-entry-activated(root.entry.name, root.entry.is-folder);
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.entry.name;
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 18px;
                overflow: elide;
            }
            Text {
                text: root.entry.info;
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.palette-border;
    }
}

// A row inside the ••• dropdown menu.
component MenuRow inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    callback triggered();
    height: 52px;
    background: touch.has-hover ? Theme.palette-secondary : transparent;

    touch := TouchArea {
        clicked => {
            root.triggered();
        }
    }
    Text {
        x: 16px;
        width: parent.width - 16px - 46px;
        height: parent.height;
        vertical-alignment: center;
        text: root.text;
        color: Theme.palette-foreground;
        font-family: "Montserrat";
        font-size: 17px;
        font-weight: 600;
        overflow: elide;
    }
    Image {
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        source: root.icon;
        colorize: Theme.palette-foreground;
    }
}

// Shared modal chrome: dimmed backdrop + panel anchored near the top so its
// fields and buttons stay above the ~396px on-screen keyboard overlay.
component ModalPanel inherits Rectangle {
    in property <string> title;
    in property <length> panel-height: 260px;
    callback cancelled();

    background: rgba(0, 0, 0, 0.55);

    TouchArea {
        clicked => {
            root.cancelled();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 24px + UISize.control-center-status-bar-height;
        width: 86%;
        height: root.panel-height;
        background: Theme.palette-surface;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.palette-border;

        // Swallow taps on the panel so they don't dismiss.
        TouchArea {}

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            Text {
                text: root.title;
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 20px;
                font-weight: 600;
            }
            @children
        }
    }
}

// The keychain (home) screen.
component KeyListView inherits VerticalLayout {
    spacing: 12px;

    HorizontalLayout {
        height: 64px;
        spacing: 8px;
        Text {
            vertical-alignment: center;
            horizontal-stretch: 1;
            text: "OpenPGP Keys";
            color: Theme.palette-foreground;
            font-family: "Montserrat";
            font-size: 22px;
            font-weight: 700;
        }
        IconBtn {
            icon: @image-url("icons/ellipsis.svg");
            diameter: 56px;
            clicked => {
                Ui.show-menu = !Ui.show-menu;
            }
        }
    }

    if Ui.message != "": Text {
        text: Ui.message;
        color: Ui.message-error ? Theme.palette-danger : Theme.palette-primary;
        font-family: "Montserrat";
        font-size: 14px;
        wrap: word-wrap;
    }
    if KeyList.status != "": Text {
        text: KeyList.status;
        color: Theme.palette-muted;
        font-family: "Montserrat";
        font-size: 16px;
        horizontal-alignment: center;
    }

    Flickable {
        vertical-stretch: 1;
        viewport-height: KeyList.keys.length * 64px;
        VerticalLayout {
            alignment: start;
            spacing: 0px;
            for item in KeyList.keys: KeyEntry {
                entry: item;
            }
        }
    }
}

// The key detail screen.
component DetailView inherits VerticalLayout {
    spacing: 10px;

    HorizontalLayout {
        height: 56px;
        spacing: 8px;
        IconBtn {
            icon: @image-url("icons/arrow-left.svg");
            clicked => {
                Callbacks.close-detail();
            }
        }
        Text {
            vertical-alignment: center;
            horizontal-stretch: 1;
            text: Detail.title;
            color: Theme.palette-foreground;
            font-family: "Montserrat";
            font-size: 18px;
            font-weight: 600;
            overflow: elide;
        }
        IconBtn {
            icon: @image-url("icons/trash-2.svg");
            icon-color: Theme.palette-danger;
            clicked => {
                Ui.show-delete = true;
            }
        }
    }

    if Ui.message != "": Text {
        text: Ui.message;
        color: Ui.message-error ? Theme.palette-danger : Theme.palette-primary;
        font-family: "Montserrat";
        font-size: 14px;
        wrap: word-wrap;
    }

    Flickable {
        vertical-stretch: 1;
        viewport-height: det.preferred-height;

        det := VerticalLayout {
            alignment: start;
            spacing: 8px;

            Text {
                text: Detail.has-secret && Detail.user-ids.length > 1
                    ? "User IDs (tap to remove)"
                    : "User IDs";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                font-weight: 700;
            }
            for uid[i] in Detail.user-ids: Rectangle {
                height: 44px;
                background: uid-touch.has-hover ? Theme.palette-secondary : transparent;
                border-radius: 10px;

                uid-touch := TouchArea {
                    clicked => {
                        if (Detail.has-secret && Detail.user-ids.length > 1) {
                            Ui.selected-uid = i;
                            Ui.selected-uid-text = uid;
                            Ui.field-pass = "";
                            Ui.show-remove-uid = true;
                        }
                    }
                }
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: uid;
                    color: Theme.palette-foreground;
                    font-family: "Montserrat";
                    font-size: 15px;
                    overflow: elide;
                }
            }

            Rectangle { height: 6px; }

            for item in Detail.rows: VerticalLayout {
                spacing: 2px;
                Text {
                    text: item.label;
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 700;
                }
                Text {
                    text: item.value;
                    color: Theme.palette-foreground;
                    font-family: "SourceCodePro";
                    font-size: 15px;
                    wrap: word-wrap;
                }
                Rectangle { height: 6px; }
            }

        }
    }

    // Fixed action bar (never scrolls, so automation taps land reliably).
    HorizontalLayout {
        height: 52px;
        spacing: 10px;
        Button {
            full-width: true;
            text: "Export";
            clicked => {
                Ui.export-kind = 0;
                Ui.export-dest = 0;
                Ui.show-export = true;
            }
        }
        if Detail.has-secret: Button {
            full-width: true;
            variant: ButtonVariant.secondary;
            text: "Expiry";
            clicked => {
                Ui.field-a = "";
                Ui.field-pass = "";
                Ui.show-expiry = true;
            }
        }
    }
    if Detail.has-secret: HorizontalLayout {
        height: 52px;
        spacing: 10px;
        Button {
            full-width: true;
            variant: ButtonVariant.secondary;
            text: "Add user ID";
            clicked => {
                Ui.field-a = "";
                Ui.field-b = "";
                Ui.field-pass = "";
                Ui.show-add-uid = true;
            }
        }
        Button {
            full-width: true;
            variant: ButtonVariant.secondary;
            text: "Passphrase";
            clicked => {
                Ui.field-a = "";
                Ui.field-b = "";
                Ui.show-change-pass = true;
            }
        }
    }
    if Detail.has-secret: HorizontalLayout {
        height: 52px;
        spacing: 10px;
        Button {
            full-width: true;
            variant: ButtonVariant.secondary;
            text: "Sign file";
            clicked => {
                Callbacks.start-sign();
            }
        }
        Button {
            full-width: true;
            variant: ButtonVariant.secondary;
            text: "Sign QR";
            clicked => {
                Callbacks.start-sign-qr();
            }
        }
    }
    HorizontalLayout {
        height: 52px;
        spacing: 10px;
        Button {
            full-width: true;
            variant: ButtonVariant.secondary;
            text: "Encrypt";
            clicked => {
                Callbacks.start-encrypt();
            }
        }
        if Detail.has-secret: Button {
            full-width: true;
            variant: ButtonVariant.secondary;
            text: "Decrypt";
            clicked => {
                Callbacks.start-decrypt();
            }
        }
    }
}

// The import file browser screen.
component ImportView inherits VerticalLayout {
    spacing: 12px;

    HorizontalLayout {
        height: 56px;
        spacing: 8px;
        IconBtn {
            icon: @image-url("icons/x.svg");
            clicked => {
                Callbacks.cancel-import();
            }
        }
        Text {
            vertical-alignment: center;
            horizontal-stretch: 1;
            text: Ui.browse-mode == 1 ? "Choose file to sign"
                : Ui.browse-mode == 2 ? "Choose file to encrypt"
                : Ui.browse-mode == 3 ? "Choose file to decrypt"
                : "Import key (.asc)";
            color: Theme.palette-foreground;
            font-family: "Montserrat";
            font-size: 18px;
            font-weight: 600;
        }
    }

    HorizontalLayout {
        // Match the SegmentedControl's natural height so the layout doesn't
        // stretch it and open a gap above the path row.
        height: 64px;
        SegmentedControl {
            horizontal-stretch: 1;
            options: ["Internal", "Airlock", "USB"];
            selected-index <=> Browser.location-index;
            changed(idx, label) => {
                Callbacks.import-location-changed(idx);
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        height: 48px;

        if !Browser.at-root: IconBtn {
            icon: @image-url("icons/arrow-left.svg");
            clicked => {
                Callbacks.import-go-back();
            }
        }
        Text {
            vertical-alignment: center;
            horizontal-stretch: 1;
            text: Browser.path;
            color: Theme.palette-muted;
            font-family: "Montserrat";
            font-size: 15px;
            overflow: elide;
        }
    }

    if Ui.message != "": Text {
        text: Ui.message;
        color: Ui.message-error ? Theme.palette-danger : Theme.palette-primary;
        font-family: "Montserrat";
        font-size: 14px;
        wrap: word-wrap;
    }
    if Browser.status != "": Text {
        text: Browser.status;
        color: Theme.palette-muted;
        font-family: "Montserrat";
        font-size: 16px;
        horizontal-alignment: center;
    }

    Flickable {
        vertical-stretch: 1;
        viewport-height: Browser.entries.length * 60px;
        VerticalLayout {
            alignment: start;
            spacing: 0px;
            for item in Browser.entries: FileEntry {
                entry: item;
            }
        }
    }
}

// The create-key form screen.
component CreateView inherits VerticalLayout {
    spacing: 14px;

    HorizontalLayout {
        height: 56px;
        spacing: 8px;
        IconBtn {
            icon: @image-url("icons/x.svg");
            clicked => {
                Callbacks.cancel-create();
            }
        }
        Text {
            vertical-alignment: center;
            horizontal-stretch: 1;
            text: "New key";
            color: Theme.palette-foreground;
            font-family: "Montserrat";
            font-size: 18px;
            font-weight: 600;
        }
    }

    if Ui.message != "": Text {
        text: Ui.message;
        color: Ui.message-error ? Theme.palette-danger : Theme.palette-primary;
        font-family: "Montserrat";
        font-size: 14px;
        wrap: word-wrap;
    }

    // The form outgrows the 800px screen (the Algorithm hint pushed the
    // Generate button past the bottom in Random mode), so it scrolls.
    Flickable {
        vertical-stretch: 1;
        viewport-height: create-form.preferred-height;

        create-form := VerticalLayout {
            alignment: start;
            spacing: 14px;

                // Keyboard "Done" blurs each field so the on-screen keyboard drops away
                // and the controls below stay tappable.
                create-name-input := Input {
                    label: "Name";
                    placeholder: "Alice Example";
                    value <=> Ui.create-name;
                    submitted => {
                        create-name-input.clear-focus();
                    }
                }
                create-email-input := Input {
                    label: "Email";
                    placeholder: "alice@example.com";
                    value <=> Ui.create-email;
                    submitted => {
                        create-email-input.clear-focus();
                    }
                }
                create-pass-input := PassInput {
                    label: "Passphrase (optional)";
                    placeholder: "Passphrase";
                    value <=> Ui.create-pass;
                }

                Text {
                    text: "Key type";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 700;
                }
                HorizontalLayout {
                    height: 64px;
                    SegmentedControl {
                        horizontal-stretch: 1;
                        options: ["Random", "From seed"];
                        selected-index <=> Ui.create-mode;
                        // Switching key types re-defaults every algorithm
                        // choice to the strongest option rather than
                        // whatever was left selected.
                        changed selected-index => {
                            Ui.create-algo = 2;
                            Ui.create-rsa-bits-index = 2;
                            Ui.create-nistp-index = 2;
                            Ui.create-seed-algo = 1;
                        }
                    }
                }

                if Ui.create-mode == 0: Text {
                    text: "Algorithm";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 700;
                }
                if Ui.create-mode == 0: HorizontalLayout {
                    height: 64px;
                    SegmentedControl {
                        horizontal-stretch: 1;
                        options: ["RSA", "Ed25519", "NIST P", "PQC"];
                        selected-index <=> Ui.create-algo;
                    }
                }
                if Ui.create-mode == 0 && Ui.create-algo == 0: Text {
                    text: "Key size";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 700;
                }
                if Ui.create-mode == 0 && Ui.create-algo == 0: HorizontalLayout {
                    height: 64px;
                    SegmentedControl {
                        horizontal-stretch: 1;
                        options: ["2048", "3072", "4096"];
                        selected-index <=> Ui.create-rsa-bits-index;
                    }
                }
                if Ui.create-mode == 0 && Ui.create-algo == 2: Text {
                    text: "Curve";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 700;
                }
                if Ui.create-mode == 0 && Ui.create-algo == 2: HorizontalLayout {
                    height: 64px;
                    SegmentedControl {
                        horizontal-stretch: 1;
                        options: ["P-256", "P-384", "P-521"];
                        selected-index <=> Ui.create-nistp-index;
                    }
                }
                // One-glance strength/compatibility note for the selected algorithm.
                if Ui.create-mode == 0: Text {
                    text: Ui.create-algo == 0
                        ? "RSA — classic and universally supported. 2048 ≈ 112-bit, 3072 ≈ 128-bit, 4096 ≈ 140-bit strength; bigger is slower to generate."
                        : Ui.create-algo == 1
                        ? "Ed25519 + Curve25519 — about 128-bit strength. The modern default: small, fast, supported by current PGP software. The same pair From-seed keys use."
                        : Ui.create-algo == 2
                        ? (Ui.create-nistp-index == 0
                            ? "NIST P-256 (secp256r1; ECDSA + ECDH) — about 128-bit strength. The most widely deployed NIST curve (GnuPG 2.1+)."
                            : Ui.create-nistp-index == 1
                            ? "NIST P-384 (secp384r1; ECDSA + ECDH) — about 192-bit strength, the CNSA-suite curve (GnuPG 2.1+)."
                            : "NIST P-521 (secp521r1; ECDSA + ECDH) — about 256-bit strength, the strongest classical option. Fast; needs ECC-aware PGP software (GnuPG 2.1+).")
                        : "Experimental — post-quantum hybrid (RFC 9980): Ed25519 signing + ML-KEM-768+X25519 encryption, sealed against future quantum computers. Needs RFC 9980-aware software; older PGP warns.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if Ui.create-mode == 1: Text {
                    text: "Algorithm";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 700;
                }
                if Ui.create-mode == 1: HorizontalLayout {
                    height: 64px;
                    SegmentedControl {
                        horizontal-stretch: 1;
                        options: ["Ed25519", "P-521"];
                        selected-index <=> Ui.create-seed-algo;
                    }
                }
                // The algorithm choice is part of the recovery recipe: each
                // algorithm derives an independent key from the same account.
                if Ui.create-mode == 1: Text {
                    text: (Ui.create-seed-algo == 1
                        ? "NIST P-521 (secp521r1; ECDSA + ECDH) — about 256-bit strength, the strongest option. Needs ECC-aware PGP software (GnuPG 2.1+)."
                        : "Ed25519 + Curve25519 — about 128-bit strength. The modern default, and this app's original derivation scheme.")
                        + " The same account number re-creates the same key only with the same algorithm — remember both.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    wrap: word-wrap;
                }
                // From-seed keys are deterministically derived from the device
                // master seed: the same account number + algorithm always
                // recreates the same key, so a seed-phrase restore recovers
                // the identity.
                if Ui.create-mode == 1: create-account-input := Input {
                    label: "Account number (same number = same key)";
                    placeholder: "0";
                    value <=> Ui.create-account;
                    submitted => {
                        create-account-input.clear-focus();
                    }
                }
                // The date has to be a fixed constant: the OpenPGP fingerprint commits to
                // the creation timestamp, so a "real" date would break re-derivation.
                if Ui.create-mode == 1: Text {
                    text: "Derived keys are always dated 2009-01-03. The date is part of the key's fingerprint, so it must be fixed for the same account to re-create the same key. It is public metadata and does not weaken the key.";
                    color: Theme.palette-muted;
                    font-family: "Montserrat";
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Button {
                    full-width: true;
                    text: Ui.create-mode == 1 ? "Derive" : "Generate";
                    clicked => {
                        if (Ui.create-mode == 1) {
                            Callbacks.create-derived-key(Ui.create-name, Ui.create-email, Ui.create-account, Ui.create-seed-algo, Ui.create-pass);
                        } else {
                            Callbacks.create-key(Ui.create-name, Ui.create-email, Ui.create-algo, Ui.create-rsa-bits-index, Ui.create-nistp-index, Ui.create-pass);
                        }
                    }
                }
        }
    }
}

export component AppWindow inherits Window {
    title: "OpenPGP Keys";
    preferred-width: 480px;
    preferred-height: 800px;
    background: Theme.palette-background;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.palette-background;

        // Main content.
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 24px + UISize.control-center-status-bar-height;
            padding-bottom: 20px;

            if Ui.screen == 0: KeyListView {}
            if Ui.screen == 1: DetailView {}
            if Ui.screen == 2: ImportView {}
            if Ui.screen == 3: CreateView {}
        }

        // --- Overlays (later siblings render on top of the content) ---

        // ••• dropdown, anchored top-right under the menu button.
        if Ui.show-menu: Rectangle {
            width: 100%;
            height: 100%;
            TouchArea {
                clicked => {
                    Ui.show-menu = false;
                }
            }
            Rectangle {
                x: parent.width - self.width - 20px;
                y: 20px + UISize.control-center-status-bar-height + 44px;
                width: 230px;
                height: 118px;
                background: Theme.palette-surface;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.palette-border;

                VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 6px;
                    MenuRow {
                        text: "New key";
                        icon: @image-url("icons/plus.svg");
                        triggered => {
                            Ui.show-menu = false;
                            Callbacks.show-create();
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.palette-border;
                    }
                    MenuRow {
                        text: "Import key";
                        icon: @image-url("icons/download.svg");
                        triggered => {
                            Ui.show-menu = false;
                            Callbacks.start-import();
                        }
                    }
                }
            }
        }

        // Extend expiration: days + passphrase.
        if Ui.show-expiry: ModalPanel {
            width: 100%;
            height: 100%;
            title: "Extend expiration";
            panel-height: 330px;
            cancelled => {
                Ui.show-expiry = false;
            }

            expiry-days-input := Input {
                label: "Days from today (empty = never)";
                placeholder: "365";
                value <=> Ui.field-a;
                submitted => {
                    expiry-days-input.clear-focus();
                }
            }
            expiry-pass-input := PassInput {
                label: "Passphrase";
                placeholder: "Passphrase";
                value <=> Ui.field-pass;
            }
            HorizontalLayout {
                spacing: 12px;
                Button {
                    full-width: true;
                    variant: ButtonVariant.secondary;
                    text: "Cancel";
                    clicked => {
                        Ui.show-expiry = false;
                    }
                }
                Button {
                    full-width: true;
                    text: "Apply";
                    clicked => {
                        Ui.show-expiry = false;
                        Callbacks.extend-expiry(Ui.field-a, Ui.field-pass);
                    }
                }
            }
        }

        // Add user ID: name + email + passphrase.
        if Ui.show-add-uid: ModalPanel {
            width: 100%;
            height: 100%;
            title: "Add user ID";
            panel-height: 410px;
            cancelled => {
                Ui.show-add-uid = false;
            }

            uid-name-input := Input {
                label: "Name";
                placeholder: "Alice Example";
                value <=> Ui.field-a;
                submitted => {
                    uid-name-input.clear-focus();
                }
            }
            uid-email-input := Input {
                label: "Email";
                placeholder: "alice@example.com";
                value <=> Ui.field-b;
                submitted => {
                    uid-email-input.clear-focus();
                }
            }
            uid-pass-input := PassInput {
                label: "Passphrase";
                placeholder: "Passphrase";
                value <=> Ui.field-pass;
            }
            HorizontalLayout {
                spacing: 12px;
                Button {
                    full-width: true;
                    variant: ButtonVariant.secondary;
                    text: "Cancel";
                    clicked => {
                        Ui.show-add-uid = false;
                    }
                }
                Button {
                    full-width: true;
                    text: "Add";
                    clicked => {
                        Ui.show-add-uid = false;
                        Callbacks.add-uid(Ui.field-a, Ui.field-b, Ui.field-pass);
                    }
                }
            }
        }

        // Remove user ID: confirmation + passphrase.
        if Ui.show-remove-uid: ModalPanel {
            width: 100%;
            height: 100%;
            title: "Remove user ID";
            panel-height: 330px;
            cancelled => {
                Ui.show-remove-uid = false;
            }

            Text {
                text: "Remove \"" + Ui.selected-uid-text + "\"?";
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 15px;
                wrap: word-wrap;
            }
            remove-pass-input := PassInput {
                label: "Passphrase";
                placeholder: "Passphrase";
                value <=> Ui.field-pass;
            }
            HorizontalLayout {
                spacing: 12px;
                Button {
                    full-width: true;
                    variant: ButtonVariant.secondary;
                    text: "Cancel";
                    clicked => {
                        Ui.show-remove-uid = false;
                    }
                }
                Button {
                    full-width: true;
                    variant: ButtonVariant.danger;
                    text: "Remove";
                    clicked => {
                        Ui.show-remove-uid = false;
                        Callbacks.remove-uid(Ui.selected-uid, Ui.field-pass);
                    }
                }
            }
        }

        // Sign file: confirm target + passphrase.
        if Ui.show-sign-pass: ModalPanel {
            width: 100%;
            height: 100%;
            title: "Sign file";
            panel-height: 330px;
            cancelled => {
                Ui.show-sign-pass = false;
            }

            Text {
                text: "Sign \"" + Ui.sign-file-name + "\" with " + Detail.title + "?";
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 15px;
                wrap: word-wrap;
            }
            sign-pass-input := PassInput {
                label: "Passphrase";
                placeholder: "Passphrase";
                value <=> Ui.field-pass;
            }
            HorizontalLayout {
                spacing: 12px;
                Button {
                    full-width: true;
                    variant: ButtonVariant.secondary;
                    text: "Cancel";
                    clicked => {
                        Ui.show-sign-pass = false;
                    }
                }
                Button {
                    full-width: true;
                    text: "Sign";
                    clicked => {
                        Ui.show-sign-pass = false;
                        Callbacks.sign-file(Ui.field-pass);
                    }
                }
            }
        }

        // Sign QR-scanned data: confirm size + passphrase.
        if Ui.show-sign-qr-pass: ModalPanel {
            width: 100%;
            height: 100%;
            title: "Sign scanned data";
            panel-height: 330px;
            cancelled => {
                Ui.show-sign-qr-pass = false;
            }

            Text {
                text: "Sign " + Ui.sign-qr-info + " with " + Detail.title + "?";
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 15px;
                wrap: word-wrap;
            }
            sign-qr-pass-input := PassInput {
                label: "Passphrase";
                placeholder: "Passphrase";
                value <=> Ui.field-pass;
            }
            HorizontalLayout {
                spacing: 12px;
                Button {
                    full-width: true;
                    variant: ButtonVariant.secondary;
                    text: "Cancel";
                    clicked => {
                        Ui.show-sign-qr-pass = false;
                    }
                }
                Button {
                    full-width: true;
                    text: "Sign";
                    clicked => {
                        Ui.show-sign-qr-pass = false;
                        Callbacks.sign-qr(Ui.field-pass);
                    }
                }
            }
        }

        // Encrypt file: confirm target, optional inner signature.
        if Ui.show-encrypt-modal: ModalPanel {
            width: 100%;
            height: 100%;
            title: "Encrypt file";
            panel-height: Ui.encrypt-sign ? 430px : 330px;
            cancelled => {
                Ui.show-encrypt-modal = false;
            }

            Text {
                text: "Encrypt \"" + Ui.sign-file-name + "\" for " + Detail.title + "?";
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 15px;
                wrap: word-wrap;
            }
            if Detail.has-secret: Checkbox {
                label: "Also sign (needs passphrase)";
                checked <=> Ui.encrypt-sign;
            }
            if Ui.encrypt-sign: encrypt-pass-input := PassInput {
                label: "Passphrase";
                placeholder: "Passphrase";
                value <=> Ui.field-pass;
            }
            HorizontalLayout {
                spacing: 12px;
                Button {
                    full-width: true;
                    variant: ButtonVariant.secondary;
                    text: "Cancel";
                    clicked => {
                        Ui.show-encrypt-modal = false;
                    }
                }
                Button {
                    full-width: true;
                    text: "Encrypt";
                    clicked => {
                        Ui.show-encrypt-modal = false;
                        Callbacks.encrypt-file(Ui.encrypt-sign, Ui.field-pass);
                    }
                }
            }
        }

        // Decrypt file: confirm target + passphrase.
        if Ui.show-decrypt-pass: ModalPanel {
            width: 100%;
            height: 100%;
            title: "Decrypt file";
            panel-height: 330px;
            cancelled => {
                Ui.show-decrypt-pass = false;
            }

            Text {
                text: "Decrypt \"" + Ui.sign-file-name + "\" with " + Detail.title + "?";
                color: Theme.palette-foreground;
                font-family: "Montserrat";
                font-size: 15px;
                wrap: word-wrap;
            }
            decrypt-pass-input := PassInput {
                label: "Passphrase";
                placeholder: "Passphrase";
                value <=> Ui.field-pass;
            }
            HorizontalLayout {
                spacing: 12px;
                Button {
                    full-width: true;
                    variant: ButtonVariant.secondary;
                    text: "Cancel";
                    clicked => {
                        Ui.show-decrypt-pass = false;
                    }
                }
                Button {
                    full-width: true;
                    text: "Decrypt";
                    clicked => {
                        Ui.show-decrypt-pass = false;
                        Callbacks.decrypt-file(Ui.field-pass);
                    }
                }
            }
        }

        // Change passphrase: old + new.
        if Ui.show-change-pass: ModalPanel {
            width: 100%;
            height: 100%;
            title: "Change passphrase";
            panel-height: 340px;
            cancelled => {
                Ui.show-change-pass = false;
            }

            old-pass-input := PassInput {
                label: "Current passphrase";
                placeholder: "Current passphrase";
                value <=> Ui.field-a;
            }
            new-pass-input := PassInput {
                label: "New passphrase (empty = remove)";
                placeholder: "New passphrase";
                value <=> Ui.field-b;
            }
            HorizontalLayout {
                spacing: 12px;
                Button {
                    full-width: true;
                    variant: ButtonVariant.secondary;
                    text: "Cancel";
                    clicked => {
                        Ui.show-change-pass = false;
                    }
                }
                Button {
                    full-width: true;
                    text: "Change";
                    clicked => {
                        Ui.show-change-pass = false;
                        Callbacks.change-passphrase(Ui.field-a, Ui.field-b);
                    }
                }
            }
        }

        // Export sheet: what + where.
        if Ui.show-export: ModalPanel {
            width: 100%;
            height: 100%;
            title: "Export key";
            panel-height: Detail.has-secret ? 400px : 310px;
            cancelled => {
                Ui.show-export = false;
            }

            if Detail.has-secret: Text {
                text: "Contents";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                font-weight: 700;
            }
            if Detail.has-secret: SegmentedControl {
                options: ["Public only", "Full secret"];
                selected-index <=> Ui.export-kind;
            }
            Text {
                text: "Destination";
                color: Theme.palette-muted;
                font-family: "Montserrat";
                font-size: 13px;
                font-weight: 700;
            }
            SegmentedControl {
                options: ["Internal", "Airlock"];
                selected-index <=> Ui.export-dest;
            }
            HorizontalLayout {
                spacing: 12px;
                Button {
                    full-width: true;
                    variant: ButtonVariant.secondary;
                    text: "Cancel";
                    clicked => {
                        Ui.show-export = false;
                    }
                }
                Button {
                    full-width: true;
                    text: "Export";
                    clicked => {
                        Ui.show-export = false;
                        if (Ui.export-kind == 1) {
                            Ui.show-export-secret-confirm = true;
                        } else {
                            Callbacks.export-key(false, Ui.export-dest);
                        }
                    }
                }
            }
        }

        if Ui.show-export-secret-confirm: export-secret-dialog := Dialog {
            width: 100%;
            height: 100%;
            open: true;
            variant: DialogVariant.danger;
            dismissed => {
                Ui.show-export-secret-confirm = false;
            }

            VerticalLayout {
                spacing: Theme.spacing-xs;
                padding-right: export-secret-dialog.close-button-size + Theme.spacing-sm;

                Text {
                    text: "Export secret key?";
                    color: export-secret-dialog.title-color;
                    font-family: export-secret-dialog.font-family;
                    font-size: export-secret-dialog.title-font-size;
                    font-weight: export-secret-dialog.title-font-weight;
                    wrap: word-wrap;
                }

                Text {
                    text: "The exported file contains your private key material. Anyone with the file (and passphrase) controls this identity.";
                    color: export-secret-dialog.message-color;
                    font-family: export-secret-dialog.font-family;
                    font-size: export-secret-dialog.font-size;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                height: Theme.border-width-sm;
                background: export-secret-dialog.separator-color;
            }

            HorizontalLayout {
                spacing: Theme.spacing-sm;
                alignment: end;

                Button {
                    text: "Cancel";
                    variant: ButtonVariant.secondary;
                    size: export-secret-dialog.size;
                    touch-expansion: 0px;
                    clicked => {
                        Ui.show-export-secret-confirm = false;
                    }
                }

                Button {
                    text: "Export secret key";
                    variant: ButtonVariant.danger;
                    size: export-secret-dialog.size;
                    touch-expansion: 0px;
                    clicked => {
                        Ui.show-export-secret-confirm = false;
                        Callbacks.export-key(true, Ui.export-dest);
                    }
                }
            }
        }

        if Ui.show-delete: delete-dialog := Dialog {
            width: 100%;
            height: 100%;
            open: true;
            variant: DialogVariant.danger;
            dismissed => {
                Ui.show-delete = false;
            }

            VerticalLayout {
                spacing: Theme.spacing-xs;
                padding-right: delete-dialog.close-button-size + Theme.spacing-sm;

                Text {
                    text: "Delete key";
                    color: delete-dialog.title-color;
                    font-family: delete-dialog.font-family;
                    font-size: delete-dialog.title-font-size;
                    font-weight: delete-dialog.title-font-weight;
                    wrap: word-wrap;
                }

                Text {
                    text: "Delete \"" + Detail.title + "\" from the keychain?" + (Detail.has-secret ? " The secret key will be gone unless you exported it." : "");
                    color: delete-dialog.message-color;
                    font-family: delete-dialog.font-family;
                    font-size: delete-dialog.font-size;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                height: Theme.border-width-sm;
                background: delete-dialog.separator-color;
            }

            HorizontalLayout {
                spacing: Theme.spacing-sm;
                alignment: end;

                Button {
                    text: "Cancel";
                    variant: ButtonVariant.secondary;
                    size: delete-dialog.size;
                    touch-expansion: 0px;
                    clicked => {
                        Ui.show-delete = false;
                    }
                }

                Button {
                    text: "Delete";
                    variant: ButtonVariant.danger;
                    size: delete-dialog.size;
                    touch-expansion: 0px;
                    clicked => {
                        Ui.show-delete = false;
                        Callbacks.delete-key(Detail.filename);
                    }
                }
            }
        }

        // Busy overlay (key generation) — topmost.
        // Signature-as-QR result: white card so phone cameras lock on fast.
        if Ui.show-sign-qr-result: Rectangle {
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            TouchArea {} // swallow taps behind the card

            VerticalLayout {
                x: 28px;
                width: parent.width - 56px;
                alignment: center;
                spacing: 16px;

                Rectangle {
                    height: self.width;
                    background: white;
                    border-radius: 12px;
                    Image {
                        width: parent.width - 32px;
                        height: parent.height - 32px;
                        source: Ui.sign-qr-image;
                        image-rendering: pixelated;
                    }
                }
                Text {
                    text: "Scan with your phone to receive the armored signature (.asc)";
                    color: white;
                    font-family: "Montserrat";
                    font-size: 15px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    height: 52px;
                    Button {
                        full-width: true;
                        text: "Done";
                        clicked => {
                            Callbacks.close-sign-qr();
                        }
                    }
                }
            }
        }

        if Ui.busy: Rectangle {
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            TouchArea {} // swallow all taps

            Rectangle {
                width: 86%;
                height: 120px;
                background: Theme.palette-surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.palette-border;

                Text {
                    x: 24px;
                    width: parent.width - 48px;
                    height: parent.height;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    text: Ui.busy-text;
                    color: Theme.palette-foreground;
                    font-family: "Montserrat";
                    font-size: 17px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
            }
        }
    }
}
